    //   - source +1 out
    //   - sink +1 in
    //   - others in == out

    vector<int> ans;

    stack<int> s;
    s.push(1);
    while (!s.empty()) {
        int a = s.top();
        if (adj[a].empty()) {
            ans.push_back(a);
            s.pop();
        } else {
            int b = *adj[a].begin();
            adj[a].erase(adj[a].begin());
            s.push(b);
        }
    }

    reverse(ans.begin(), ans.end());

