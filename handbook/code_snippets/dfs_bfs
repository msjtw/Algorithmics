vector<bool> vis;

int dfs(int a) {
    vis[a] = true;

    int total = 0;
    for (int b : adj[a]) {
        if (!vis[b]) {
            total += dfs(b);
        }
    }
    return total + adj[a].size();
}

void bfs(int s, const vector<vector<int>>& adj, vector<int>& lvl) {
    queue<int> q;
    q.push(s);
    lvl[s] = 1;

    while (!q.empty()) {
        int p = q.front();
        q.pop();

        for (int v : adj[p]) {
            if (lvl[v] == 0) {
                lvl[v] = lvl[p] + 1;
                q.push(v);
            }
        }
    }
}
